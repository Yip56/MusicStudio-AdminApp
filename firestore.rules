rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A provisioned account: has a users/{uid} doc with a real role. Google sign-in is open to every Google
    // account, so a bare login (request.auth != null) proves nothing; role-less ("denied") logins fail this.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["teacher", "admin", "sysadmin"];
    }

    function isSysadmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin";
    }

    function isAdminOrAbove() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "sysadmin"];
    }

    function isFinalized(yearMonth) {
      return exists(/databases/$(database)/documents/month_snapshots/$(yearMonth));
    }

    // A users/{uid} doc may only be created by redeeming a sysadmin-created invite for the caller's own
    // verified Google email. role and teacherId are copied from that invite, never chosen by the caller.
    // (The bootstrap sysadmin is created in the Firebase console, which bypasses these rules.)
    function isValidInviteClaim(uid) {
      let d = request.resource.data;
      return d.inviteId is string
        && !d.inviteId.matches('.*/.*')
        && d.keys().hasOnly(["uid", "email", "displayName", "photoURL", "role", "teacherId",
                             "createdAt", "createdBy", "claimedAt", "inviteId"])
        && request.auth.token.email_verified == true
        && d.uid == uid
        && d.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/invites/$(d.inviteId)).data.email == d.email
        && get(/databases/$(database)/documents/invites/$(d.inviteId)).data.role == d.role
        && d.role in ["teacher", "admin", "sysadmin"]
        && get(/databases/$(database)/documents/invites/$(d.inviteId)).data.get("teacherId", null) == d.get("teacherId", null)
        && get(/databases/$(database)/documents/invites/$(d.inviteId)).data.get("createdBy", null) == d.get("createdBy", null);
    }

    // Active user accounts — doc ID is their Firebase Auth UID
    match /users/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdminOrAbove());
      allow create: if request.auth != null && request.auth.uid == uid && isValidInviteClaim(uid); // invite claim on first sign-in
      allow update: if isSysadmin();
      allow delete: if isSysadmin();
    }

    // Pending invites — created by sysadmin, claimed by the invited user on first sign-in.
    // A signed-in account can only see (and, once claimed, delete) the invite addressed to its own email.
    match /invites/{inviteId} {
      allow read:   if isSysadmin()
        || (request.auth != null && resource.data.email == request.auth.token.email.lower());
      allow create: if isSysadmin();
      allow update: if isSysadmin();
      allow delete: if isSysadmin()
        || (request.auth != null && resource.data.email == request.auth.token.email.lower());
    }

    match /notifications/{notifId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isSysadmin();
    }

    // Payroll ledger (fee collected / discount / deferral / payout paid).
    // Frozen for good once the month has been finalized — corrections go through month_revisions.
    match /payroll_months/{yearMonth} {
      allow read:   if isStaff();
      allow write:  if isAdminOrAbove() && !isFinalized(yearMonth);
    }

    // Finalized month snapshot — create once by admin/sysadmin, never edited or deleted.
    match /month_snapshots/{yearMonth} {
      allow read:   if isAdminOrAbove();
      allow create: if isAdminOrAbove();
      allow update, delete: if false;
    }

    // Corrections to a finalized month — append-only, sysadmin only. The snapshot is never touched.
    match /month_revisions/{revisionId} {
      allow read:   if isAdminOrAbove();
      allow create: if isSysadmin();
      allow update, delete: if false;
    }

    // Makeup class scheduling — teachers and admins can create/delete
    match /class_deferrals/{deferralId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Fee schedule — readable by any provisioned user; writable only by admin/sysadmin.
    // Public reads are served exclusively through the getPublicFees Cloud Function (admin SDK),
    // which bypasses these rules entirely — no unauthenticated client access is granted here.
    match /fees/{docId} {
      allow read:  if isStaff();
      allow write: if isAdminOrAbove();
    }

    // ── Studio data (was in-memory; now persisted) ──────────────────────────────
    // Teachers need to read everything to render the calendar (clash detection, "Occupied" slots);
    // the app filters what a teacher sees. Only admin/sysadmin can change people, rooms and enrolments.
    match /students/{id}   { allow read: if isStaff(); allow write: if isAdminOrAbove(); }
    // A teacher may move the day/start/end time of their OWN enrolment — nothing else (not duration, room, fee…).
    function isOwnTeacherScheduleEdit() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return me.role == "teacher" && me.teacherId != null
        && resource.data.teacherId == me.teacherId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["schedule"])
        && request.resource.data.schedule.diff(resource.data.schedule).affectedKeys().hasOnly(["dayOfWeek", "startTime", "endTime"])
        && request.resource.data.schedule.duration == resource.data.schedule.duration;
    }
    match /enrolments/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdminOrAbove();
      allow update: if isAdminOrAbove() || (isStaff() && isOwnTeacherScheduleEdit());
    }
    match /teachers/{id}   { allow read: if isStaff(); allow write: if isAdminOrAbove(); }
    match /rooms/{id}      { allow read: if isStaff(); allow write: if isAdminOrAbove(); }
    match /discounts/{id}  { allow read: if isAdminOrAbove(); allow write: if isAdminOrAbove(); }
    match /settings/{id}   { allow read: if isStaff(); allow write: if isAdminOrAbove(); }

    // Teachers mark attendance and book one-off sessions from the calendar.
    match /attendance/{id}        { allow read, write: if isStaff(); }
    match /one_off_sessions/{id}  { allow read, write: if isStaff(); }

    // Public-holiday overrides, studio closures and "run this 5th-week lesson" — teachers read, admins write.
    match /calendar_overrides/{id} { allow read: if isStaff(); allow write: if isAdminOrAbove(); }

    // Deposits: one per enrolment (doc id = enrolmentId). A deposit can only move
    // pending → held → applied/forfeited. Once applied or forfeited the record is immutable
    // (it can't be edited; it is only removed when its student is deleted).
    match /deposits/{enrolmentId} {
      allow read:   if isAdminOrAbove();
      allow create: if isAdminOrAbove() && request.resource.data.status in ["pending", "held"];
      allow update: if isAdminOrAbove()
                    && resource.data.status in ["pending", "held"]
                    && request.resource.data.status in ["pending", "held", "applied", "forfeited"]
                    && request.resource.data.enrolmentId == resource.data.enrolmentId
                    // the snapshot amount cannot be rewritten at the moment it is applied / forfeited
                    && (request.resource.data.status in ["pending", "held"]
                        || request.resource.data.amount == resource.data.amount);
      // Deleting is allowed in any status so that deleting a student removes all of their data.
      allow delete: if isAdminOrAbove();
    }

    // Activity log — any provisioned user may append, only admins read, nobody edits or deletes.
    match /activity_log/{id} {
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid;
      allow read:   if isAdminOrAbove();
      allow update, delete: if false;
    }
  }
}
